# Settings for docker-compose.yml. Copy this file to `.env` (which git ignores)
# and fill it in. Docker Compose reads `.env` on its own, and a real environment
# variable of the same name wins over the file.
#
# This is not back-end/.env.example: that one is for `npm run dev` outside Docker.
# Any other setting from it (EXTRACTION_*, CRON_*, ...) can be added here too.

# --- Required -----------------------------------------------------------------

# MongoDB Atlas connection string. The database is not part of the stack.
MONGODB_URI=

# A long random string that signs sessions and email links. The API refuses to
# start in production without it. Generate one with: openssl rand -base64 48
AUTH_SECRET=

# --- URLs: must match the host the stack is served from -----------------------

# Where users open the web app. CORS_ORIGIN may be a comma-separated list.
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Where a browser reaches the API, including /api. It is also built into the
# front-end image, so after changing it run `docker compose up --build`.
# Use HTTPS URLs on a real deployment (the links in emails use these).
PUBLIC_API_URL=http://localhost:4000/api

# --- Email (needed for sign-up and password reset in production) ---------------

# Gmail SMTP with an App Password, or Resend with a verified domain.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# --- Google Cloud (optional) ---------------------------------------------------

# Leave GCP_PROJECT_ID empty to run on the built-in stubs: every AI call returns
# a zero-confidence placeholder and routes the record to manual review.
GCP_PROJECT_ID=
# Must match the region the Document AI processor was created in; "us" is only
# a placeholder.
GCP_LOCATION=us
DOC_AI_PROCESSOR_ID=
VERTEX_AI_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.5-flash

# Folder holding the service account key, which must be named
# service-account.json and readable by user ID 1000 (the container's `node` user).
GCP_CREDENTIALS_DIR=./secrets

# --- Scheduler -----------------------------------------------------------------

# Off unless set to true: the daily crawl of the agency sites must be a
# deliberate choice. Set it to true only on the deployed environment, and run a
# single back-end (see docker-compose.yml).
SCHEDULER_ENABLED=false

# Time zone the cron expressions are read in (CRON_DGA=0 2 * * * means 02:00 here).
APP_TIMEZONE=Asia/Bangkok

# --- Ports published on the host ------------------------------------------------

# If you change BACKEND_PORT, change PUBLIC_API_URL to match.
BACKEND_PORT=4000
FRONTEND_PORT=3000
