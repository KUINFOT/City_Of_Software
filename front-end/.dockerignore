# Build context for front-end/Dockerfile. Patterns are relative to this directory;
# `**/` also catches nested copies.

# Installed and built inside the image
**/node_modules
.next
out

# Local configuration: NEXT_PUBLIC_API_URL is a build argument, not a file
**/.env
**/.env.*

# Not needed to build or run the app
*.tsbuildinfo
**/*.log
.DS_Store
.git
.gitignore
Dockerfile
.dockerignore
