# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/city_of_software?retryWrites=true&w=majority

# --- Google Cloud (only needed when wiring the real AI calls) ---
GCP_PROJECT_ID=
GCP_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
DOC_AI_PROCESSOR_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash

# --- Extraction pipeline ---
# Where downloaded TOR/announcement PDFs are stored (local disk by default).
EXTRACTION_STORAGE_DIR=./storage
# Minimum delay between requests to the same host, in milliseconds.
# Do not set below 1000 — every source in the registry is crawled politely,
# and some ask for a longer crawl-delay in robots.txt, which is honoured.
EXTRACTION_DELAY_MS=1000
# Override the outbound User-Agent. Keep it honest and contactable; the
# default names the project and links the repository.
EXTRACTION_USER_AGENT=
