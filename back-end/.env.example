# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/city_of_software?retryWrites=true&w=majority

# --- Google Cloud (only needed when wiring the real AI calls) ---
GCP_PROJECT_ID=
GCP_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
DOC_AI_PROCESSOR_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash
