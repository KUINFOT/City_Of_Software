# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Public URLs used in email verification links. For a deployed system, use HTTPS URLs.
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api

# Email verification delivery. For an academic/local project, Gmail SMTP is
# the simplest option. Create a dedicated Gmail account, enable 2-Step
# Verification, then create an App Password. Do not use your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend is supported as an alternative for a deployed system with a verified
# domain. Leave all email settings blank for local development: the verification
# link is written to the backend terminal instead of sent by email.
RESEND_API_KEY=
EMAIL_FROM=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/city_of_software?retryWrites=true&w=majority

# --- Google Cloud (only needed when wiring the real AI calls) ---
# Left blank, every AI call falls back to a safe stub (zero confidence,
# routes everything to manual review) — see gcpConfig.ts / documentAI.service.ts
# / gemini.service.ts. No code change is needed to run without credentials.
GCP_PROJECT_ID=
# Must exactly match the region the Document AI processor below was created
# in — the GCP console picks a region at processor-creation time, and a
# processor cannot move afterward. "us" here is only a placeholder; check
# the processor's own detail page in the console for its real region
# (asia-southeast1 for this project, confirmed by live testing 2026-09-14 —
# also the sensible choice for a Bangkok-based platform).
GCP_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Must reference a Document AI processor with Thai OCR support enabled
# (configured at processor-creation time in the GCP console) — FR-EXT-04.
DOC_AI_PROCESSOR_ID=
# Gemini access, via the Gemini Enterprise Agent Platform (the 2026 rebrand
# of Vertex AI — same underlying project/location/billing, just a new name
# and, on the Node side, the @google/genai SDK instead of the deprecated
# @google-cloud/vertexai package). Any region with model access works;
# asia-southeast1 (Singapore) is the sensible default for a Thailand-based
# platform — lower latency than a US region, no persisted resource tied to
# this value (unlike GCP_LOCATION/DOC_AI_PROCESSOR_ID above, which ARE
# region-locked once the processor is created).
VERTEX_AI_LOCATION=asia-southeast1
# A Flash-Lite tier model would be the right choice for this pipeline (only
# structured field extraction, not open-ended reasoning, and every
# extraction already goes through grounding checks + mandatory human review
# by default — BR-03) — but gemini-2.5-flash is what's actually confirmed
# working here: live-tested against a real project on 2026-09-14, every
# newer/lighter model name tried (gemini-3.5-flash-lite, gemini-3-flash,
# gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-flash, ...) 404'd as
# "not found or your project does not have access to it." Revisit once a
# lighter tier is confirmed available on your project's access tier.
VERTEX_AI_MODEL=gemini-2.5-flash

# --- Extraction pipeline ---
# Where downloaded TOR/announcement PDFs are stored (local disk by default).
EXTRACTION_STORAGE_DIR=./storage
# Minimum delay between requests to the same host, in milliseconds.
# Do not set below 1000 — every source in the registry is crawled politely,
# and some ask for a longer crawl-delay in robots.txt, which is honoured.
EXTRACTION_DELAY_MS=1000
# Override the outbound User-Agent. Keep it honest and contactable; the
# default names the project and links the repository.
EXTRACTION_USER_AGENT=

# --- AI extraction & review routing (FR-EXT-05, BR-03) ---
# Below this overall confidence, a record always goes to pending_review.
EXTRACTION_REVIEW_THRESHOLD=0.75
# Auto-publish is OFF by default (TBD-01: "the conservative default is
# manual review for every record"). Set true only with a deliberate,
# documented decision to enable it.
EXTRACTION_AUTO_PUBLISH_ENABLED=false
# A record must ALSO clear this stricter threshold to auto-publish.
EXTRACTION_AUTO_PUBLISH_THRESHOLD=0.92
# Automatic retries before a failed document is parked, not lost (NFR-REL-03).
EXTRACTION_MAX_ATTEMPTS=3
# Documents processed per extraction-sweep run.
EXTRACTION_SWEEP_BATCH_SIZE=20
# Temporary dev-only hard ceiling on total documents ever stored/processed (0 = no limit).
EXTRACTION_MAX_DOCUMENTS=0
# Grace period before a TOR with zero attachments is routed to review anyway.
EXTRACTION_DOCLESS_GRACE_HOURS=24
# Rough per-document AI cost estimate in THB (FR-EXT-10) — a placeholder
# until real GCP billing data exists to calibrate it.
EXTRACTION_EST_COST_PER_DOC_THB=2

# --- Duplicate detection (FR-EXT-08, TBD-02 — unvalidated default) ---
DUPLICATE_MATCH_THRESHOLD=0.65

# --- Outlier analytics (FR-ANL-04/05, TBD-02 — unvalidated defaults) ---
OUTLIER_IQR_MULTIPLIER=1.5
OUTLIER_MIN_COMPARABLE_N=5

# --- Key dates (US-019/FR-REP-07) ---
# A key date within this many days is visually emphasised as urgent.
KEY_DATE_URGENT_WITHIN_DAYS=7

# --- Scheduler (US-036) ---
# Deliberately OFF by default: a local `npm run dev` must not silently start
# crawling live government sites in the background. Set true in the deployed
# environment's configuration.
SCHEDULER_ENABLED=false
CRON_DGA=0 2 * * *
CRON_MOL=0 3 * * *
CRON_MOC=0 4 * * *
CRON_ITD=0 5 * * *
CRON_DEPA=0 6 * * 1
CRON_EXTRACTION_SWEEP=*/30 * * * *
CRON_ANALYTICS=0 7 * * *
CRON_DIGEST=0 8 * * *
